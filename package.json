{
  "name": "festival-v-dy-3d-galerie",
  "version": "1.0.0",
  "description": "Interaktivní galerie 3D modelů exponátů pro dotykovou obrazovku bez připojení k internetu",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 5000",
    "electron": "npm run build && electron .",
    "package:win": "npm run build && electron-packager . \"3D Galerie\" --platform=win32 --arch=x64 --out=release --overwrite --no-asar --ignore=\"^/(src|public|release|exponaty-dev|node_modules|\\.git)($|/)\" --ignore=\"^/(README\\.md|vite\\.config\\.js|\\.gitignore|package-lock\\.json)$\""
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^43.4.0",
    "vite": "^5.4.10"
  }
}
